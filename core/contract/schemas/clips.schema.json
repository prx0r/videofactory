{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Filed overlay clips",
  "type": "object",
  "propertyNames": {
    "pattern": "^b[0-9]+$"
  },
  "additionalProperties": {
    "type": "object",
    "required": [
      "asset",
      "complete_bid",
      "why"
    ],
    "additionalProperties": false,
    "properties": {
      "asset": {
        "type": "string",
        "pattern": "\\S"
      },
      "complete_bid": {
        "type": "string",
        "pattern": "^b[0-9]+$"
      },
      "clear": {
        "type": "string",
        "enum": [
          "fade",
          "cut"
        ]
      },
   "fade": {
    "type": "number",
    "exclusiveMinimum": 0
   },
   "fullscreen": {
    "type": "boolean"
   },
      "why": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  }
}