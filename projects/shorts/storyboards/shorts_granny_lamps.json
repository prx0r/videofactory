 "lines": [
  {
   "directed": "You could assemble every lamp, every candle, every instrument of illumination in the entire universe.",
   "maps_to": [
    "ch02-b123"
   ],
   "voice": "granny"
  },
  {
   "directed": "None of them would contribute a single ray to the sun’s own radiance.",
   "maps_to": [
    "ch02-b124"
   ],
   "voice": "granny"
  },
  {
   "directed": "And likewise, no collection of spiritual techniques can produce the self-luminous Śiva.",
   "maps_to": [
    "ch02-b125"
   ],
   "voice": "granny"
  },
  {
   "directed": "For one who genuinely sees this, divine immersion is immediate.",
   "maps_to": [
    "ch02-b126"
   ],
   "voice": "granny"
  },
  {
   "directed": "In an instant.",
   "maps_to": [
    "ch02-b128"
   ],
   "voice": "granny"
  },
  {
   "directed": "And that’s anupāya.",
   "maps_to": [
    "ch02-b129"
   ],
   "voice": "granny"
  },
  {
   "directed": "The pathless path.",
   "maps_to": [
    "ch02-b130"
   ],
   "voice": "granny"
  },
  {
   "directed": "Not that you’ve finally found the perfect technique.",
   "maps_to": [
    "ch02-b131"
   ],
   "voice": "granny"
  }
 ]
}