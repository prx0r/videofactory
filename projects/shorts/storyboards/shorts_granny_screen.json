 "est_s": 33.6,
 "lines": [
  {
   "directed": "But from the standpoint of Trika, the ultimate reality of consciousness is not exhausted by any of these states.",
   "maps_to": [
    "s07-b31"
   ],
   "voice": "granny"
  },
  {
   "directed": "The accomplished yogi recognises that reality through their transformations.",
   "maps_to": [
    "s07-b32"
   ],
   "voice": "granny"
  },
  {
   "directed": "Imagine three films being projected onto a screen.",
   "maps_to": [
    "s07-b33"
   ],
   "voice": "granny"
  },
  {
   "directed": "An action film.",
   "maps_to": [
    "s07-b34"
   ],
   "voice": "granny"
  },
  {
   "directed": "A romantic comedy.",
   "maps_to": [
    "s07-b35"
   ],
   "voice": "granny"
  },
  {
   "directed": "And an entirely black film in which nothing happens.",
   "maps_to": [
    "s07-b36"
   ],
   "voice": "granny"
  },
  {
   "directed": "The images differ.",
   "maps_to": [
    "s07-b37"
   ],
   "voice": "granny"
  },
  {
   "directed": "But the screen is not destroyed whenever the film changes.",
   "maps_to": [
    "s07-b38"
   ],
   "voice": "granny"
  },
  {
   "directed": "Now take that metaphor carefully: unlike an ordinary screen, Śiva is not an inert support. Śiva is self-aware and free.",
   "maps_to": [
    "s07-b39"
   ],
   "voice": "granny"
  }
 ]
}