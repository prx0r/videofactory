 "lines": [
  {
   "directed": "Sauṣumṇa — relating to Suṣumṇā, the central subtle channel.",
   "maps_to": [
    "s76-b22"
   ],
   "voice": "granny"
  },
  {
   "directed": "Now, the first thing to understand is that Kṣemarāja doesn’t simply treat nāsikā as the physical nose.",
   "maps_to": [
    "s76-b23"
   ],
   "voice": "granny"
  },
  {
   "directed": "This is absolutely crucial.",
   "maps_to": [
    "s76-b24"
   ],
   "voice": "granny"
  },
  {
   "directed": "He interprets it as the vital power moving in a winding or curved manner through the subtle channels.",
   "maps_to": [
    "s76-b25"
   ],
   "voice": "granny"
  },
  {
   "directed": "And the antar of that vital power refers to its inner conscious reality.",
   "maps_to": [
    "s76-b27"
   ],
   "voice": "granny"
  },
  {
   "directed": "Then the madhya is the innermost centre.",
   "maps_to": [
    "s76-b28"
   ],
   "voice": "granny"
  },
  {
   "directed": "The supreme vimarśa.",
   "maps_to": [
    "s76-b29"
   ],
   "voice": "granny"
  },
  {
   "directed": "The reflexive I-consciousness of Śiva.",
   "maps_to": [
    "s76-b30"
   ],
   "voice": "granny"
  }
 ]
}