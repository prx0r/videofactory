 "lines": [
  {
   "directed": "Śiva isn’t retiring.",
   "maps_to": [
    "s57-b24"
   ],
   "voice": "granny"
  },
  {
   "directed": "He’s not looking for a replacement.",
   "maps_to": [
    "s57-b25"
   ],
   "voice": "granny"
  },
  {
   "directed": "The yogi’s recognition of their supreme conscious nature is what makes this equality intelligible.",
   "maps_to": [
    "s57-b26"
   ],
   "voice": "granny"
  },
  {
   "directed": "And Kṣemarāja introduces another important term.",
   "maps_to": [
    "s57-b27"
   ],
   "voice": "granny"
  },
  {
   "directed": "Beyond the fourth.",
   "maps_to": [
    "s57-b29"
   ],
   "voice": "granny"
  },
  {
   "directed": "Now, we’ve already encountered turya.",
   "maps_to": [
    "s57-b30"
   ],
   "voice": "granny"
  },
  {
   "directed": "The fourth state underlying waking, dreaming and deep sleep.",
   "maps_to": [
    "s57-b31"
   ],
   "voice": "granny"
  },
  {
   "directed": "But turyātīta points towards a condition in which the recognition of supreme consciousness is no longer apprehended merely as another distinguishable state among states.",
   "maps_to": [
    "s57-b32"
   ],
   "voice": "granny"
  }
 ]
}