 "lines": [
  {
   "directed": "But if the world is Śiva’s own manifestation, that division cannot be ultimate.",
   "maps_to": [
    "s56-b84"
   ],
   "voice": "granny"
  },
  {
   "directed": "The point is not to manufacture a private spiritual experience insulated from reality.",
   "maps_to": [
    "s56-b85"
   ],
   "voice": "granny"
  },
  {
   "directed": "It’s to recognise reality through all its appearances.",
   "maps_to": [
    "s56-b86"
   ],
   "voice": "granny"
  },
  {
   "directed": "And here we can see why Śāktopāya was so important.",
   "maps_to": [
    "s56-b87"
   ],
   "voice": "granny"
  },
  {
   "directed": "The mind is mantra.",
   "maps_to": [
    "s56-b90"
   ],
   "voice": "granny"
  },
  {
   "directed": "Mental activity can become an instrument of recognition when its source is understood.",
   "maps_to": [
    "s56-b91"
   ],
   "voice": "granny"
  },
  {
   "directed": "And now:",
   "maps_to": [
    "s56-b92"
   ],
   "voice": "granny"
  }
 ]
