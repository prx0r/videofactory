 "lines": [
  {
   "directed": "The idea is that the yogi manifests according to svamātrā, the measure belonging to their own consciousness.",
   "maps_to": [
    "s49-b18"
   ],
   "voice": "granny"
  },
  {
   "directed": "But Kṣemarāja doesn’t leave mātrā as a vague expression.",
   "maps_to": [
    "s49-b19"
   ],
   "voice": "granny"
  },
  {
   "directed": "He gives a fascinating explanation.",
   "maps_to": [
    "s49-b20"
   ],
   "voice": "granny"
  },
  {
   "directed": "It is a contracted or condensed aspect of the essence of consciousness.",
   "maps_to": [
    "s49-b21"
   ],
   "voice": "granny"
  },
  {
   "directed": "A kind of solidification of the essence of consciousness.",
   "maps_to": [
    "s49-b23"
   ],
   "voice": "granny"
  },
  {
   "directed": "Not literal physical solidification, of course.",
   "maps_to": [
    "s49-b24"
   ],
   "voice": "granny"
  },
  {
   "directed": "This is a metaphysical description.",
   "maps_to": [
    "s49-b25"
   ],
   "voice": "granny"
  },
  {
   "directed": "But the imagery is extraordinary.",
   "maps_to": [
