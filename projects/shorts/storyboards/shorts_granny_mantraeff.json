 "lines": [
  {
   "directed": "Kṣemarāja insists that the efficacy of mantra does not ultimately reside in an arrangement of letters considered separately from consciousness.",
   "maps_to": [
    "s23-b44"
   ],
   "voice": "granny"
  },
  {
   "directed": "The living power of mantra is realised through identification with the conscious reality of its deity.",
   "maps_to": [
    "s23-b45"
   ],
   "voice": "granny"
  },
  {
   "directed": "And this is an absolutely enormous claim.",
   "maps_to": [
    "s23-b46"
   ],
   "voice": "granny"
  },
  {
   "directed": "Imagine chanting:",
   "maps_to": [
    "s23-b47"
   ],
   "voice": "granny"
  },
  {
   "directed": "Oṃ namaḥ śivāya.",
   "maps_to": [
    "s23-b49"
   ],
   "voice": "granny"
  },
  {
   "directed": "You can pronounce those sounds mechanically.",
   "maps_to": [
    "s23-b50"
   ],
   "voice": "granny"
  },
  {
   "directed": "You can repeat them while making breakfast.",
   "maps_to": [
    "s23-b51"
   ],
   "voice": "granny"
  },
  {
   "directed": "You can count them on a string of beads.",
   "maps_to": [
    "s23-b52"
   ],
   "voice": "granny"
  }
 ]
}